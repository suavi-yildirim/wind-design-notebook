{
  "section.A": "A = \\tfrac{\\pi}{4}\\left(D^2 - (D-2t)^2\\right)",
  "section.I": "I = \\tfrac{\\pi}{64}\\left(D^4 - (D-2t)^4\\right)",
  "section.W": "W = \\tfrac{2I}{D}",
  "f1.hand": "\\begin{aligned} \\frac{1}{k} &= \\frac{H^3}{3EI} + \\frac{H^2}{k_{\\varphi}} \\\\ f_1 &= \\frac{1}{2\\pi}\\sqrt{\\frac{k}{M_{\\mathrm{RNA}} + 0.24\\,m_{\\mathrm{Turm}}}} \\end{aligned}",
  "f1.rayleigh": "\\begin{aligned} \\omega^2 &= \\frac{\\int_0^H EI\\,w''^2\\,dz + k_{\\varphi}\\,w'(0)^2}{\\int_0^H \\mu\\,w^2\\,dz + M_{\\mathrm{RNA}}\\,w(H)^2} \\\\ f_1 &= \\frac{\\omega}{2\\pi} \\end{aligned}",
  "bands.window": "\\begin{aligned} f_{1P} &= \\frac{n}{60}, \\qquad f_{3P} = 3\\,f_{1P} \\\\ f_{1P,\\max}(1+m) &\\le f_1 \\le f_{3P,\\min}(1-m) \\end{aligned}",
  "check.freq": "\\eta_f = \\max\\!\\left(\\frac{f_{1P,\\max}(1+m)}{f_1},\\; \\frac{f_1}{f_{3P,\\min}(1-m)}\\right)",
  "load.thrust": "F_T = \\tfrac12\\,\\rho_{\\mathrm{air}}\\,A_{\\mathrm{Rotor}}\\,C_T\\,V_{\\mathrm{rated}}^2",
  "load.drag": "\\begin{aligned} q(z) &= \\tfrac12\\,\\rho_{\\mathrm{air}}\\,v(z)^2\\,c_f\\,D(z) \\\\ v(z) &= V_{\\mathrm{rated}}\\left(\\tfrac{z}{H}\\right)^{\\alpha} \\end{aligned}",
  "load.moment": "\\begin{aligned} M_d(z) = \\gamma_F\\,k_{\\mathrm{peak}} \\Big[ &F_T\\,(H-z) \\\\ &+ \\int_z^H q(\\zeta)\\,(\\zeta - z)\\,d\\zeta \\Big] \\end{aligned}",
  "load.normal": "N(z) = \\gamma_G\\,g\\left(M_{\\mathrm{RNA}} + m_{\\mathrm{Turm}}(>z)\\right)",
  "check.stress": "\\begin{aligned} \\sigma &= \\frac{N}{A} + \\frac{M_d}{W} \\\\ \\eta_{\\sigma} &= \\frac{\\sigma}{f_y(t)/\\gamma_{M1}} \\end{aligned}",
  "check.transport": "\\begin{aligned} \\eta_D &= \\frac{D_{\\mathrm{Segment,max}}}{D_{\\mathrm{Transport}}} \\\\ \\eta_L &= \\frac{L_{\\mathrm{Segment}}}{L_{\\max}} \\\\ \\eta_m &= \\frac{m_{\\mathrm{Segment}}}{m_{\\max}} \\end{aligned}",
  "check.concrete": "\\eta_{m,c} = \\frac{m_{\\mathrm{Ring}}/n_{\\mathrm{Teile}}}{m_{\\max}}",
  "check.crane": "\\begin{aligned} \\eta_{\\mathrm{Kran}} &= \\frac{m_{\\mathrm{Hub,max}}}{\\mathrm{Traglast}(H + 10\\,\\mathrm{m})} \\\\ m_{\\mathrm{Hub,max}} &= \\max(m_{\\mathrm{Segment}},\\, m_{\\mathrm{Betonteil}}, \\\\ &\\qquad\\;\\; m_{\\mathrm{Gondel}},\\, m_{\\mathrm{Rotor}}) \\end{aligned}",
  "scaling.7mw": "D \\propto \\sqrt{P},\\quad n \\propto \\tfrac{1}{D},\\quad m \\propto D^{2.5}"
}
